# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/streetmend

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Initial Platform Administrator Seed Credentials
ADMIN_EMAIL=admin@streetmend.gov
ADMIN_PASSWORD=Admin@123456

# Token & Refresh Token Settings
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_MS=604800000
EMAIL_VERIFICATION_EXPIRES_IN_MS=86400000
PASSWORD_RESET_EXPIRES_IN_MS=900000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Nodemailer / SMTP Email Transport
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@streetmend.gov

# Cloudinary Media Storage (Optional for local development; required for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Moderation Rules
FLAG_THRESHOLD=3
